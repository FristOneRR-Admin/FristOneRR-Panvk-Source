[binaries]
c = 'clang'
cpp = 'clang++'
ar = 'llvm-ar'
strip = 'llvm-strip'
pkgconfig = 'pkg-config'
mesa_clc = '/data/data/com.termux/files/home/mesa/build-host/src/util/mesa_clc'

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'armv8-a'
endian = 'little'

[built-in options]
c_args = '-target aarch64-linux-android35 -I/data/data/com.termux/files/home/mesa-android-stubs -DANDROID'
cpp_args = '-target aarch64-linux-android35 -I/data/data/com.termux/files/home/mesa-android-stubs -DANDROID'

[properties]
platform-sdk-version = '35'
